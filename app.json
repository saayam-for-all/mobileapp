{
  "expo": {
    "name": "SaayamMobileApp",
    "slug": "SaayamMobileApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saayam.mobileapp",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to the microphone to record audio messages.",
        "NSFaceIDUsageDescription": "We use Face ID to securely sign you in to your account.",
        "NSLocationWhenInUseUsageDescription": "For Volunteers: Saayam needs your location.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Saayam needs background location access to match nearby help requests.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.saayam.mobileapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidFix.cjs",
      ["expo-build-properties", {
        "android": {
          "enableJetifier": true,
          "jvmArgs": "-Xmx4096m -XX:MaxMetaspaceSize=512m"
        }
      }],
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      [
        "@siteed/expo-audio-studio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-font",
      "expo-location"
    ]
  }
}